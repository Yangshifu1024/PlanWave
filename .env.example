# PlanWave 服务端配置模板。复制为 .env 后按需修改。
# 未设置 DATABASE_URL 时，服务端使用内存存储（适合本地开发与 E2E 测试，重启即清空）。

# 云服务商提供的 MySQL 8.0 连接串（生产/联调用）
# DATABASE_URL=mysql://planwave:password@host:3306/planwave

# HTTP 监听地址
PLANWAVE_LISTEN=127.0.0.1:8787

# JWT 签名密钥（生产环境必须更换为长随机串，例如 `openssl rand -base64 64`）
PLANWAVE_JWT_SECRET=dev-only-change-me

# access token 有效期（分钟）/ refresh token 有效期（天）
PLANWAVE_ACCESS_TOKEN_MINUTES=15
PLANWAVE_REFRESH_TOKEN_DAYS=30

# 日志级别：trace|debug|info|warn|error
RUST_LOG=planwave_server=debug,tower_http=info

# ---------- 部署（deploy/docker-compose.yml 用） ----------

# GitHub CI 推送到 GHCR 的镜像（改成你的 GitHub 用户名/组织名）
# PLANWAVE_SERVER_IMAGE=ghcr.io/your-name/planwave-server:latest
# PLANWAVE_WEB_IMAGE=ghcr.io/your-name/planwave-web:latest

# web 容器（nginx）在宿主上的绑定地址与端口；
# 默认只绑回环，由宿主上已运行的全局 Caddy 反代并终结 TLS
# WEB_BIND=127.0.0.1
# WEB_PORT=8080

